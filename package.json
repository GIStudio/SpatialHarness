{
  "name": "spatial-harness",
  "version": "0.1.0",
  "type": "module",
  "description": "SpatialHarness —— 纯本地 WebGIS 工作台：引擎抽象层 + OpenLayers v1，File System Access API 直读本地磁盘，QGIS 风格现代化组件化 UI",
  "keywords": [
    "webgis",
    "gis",
    "openlayers",
    "qgis",
    "geojson",
    "shapefile",
    "geopackage",
    "mapping",
    "spatial-analysis",
    "gistudio"
  ],
  "homepage": "https://gistudio.github.io/SpatialHarness/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GIStudio/SpatialHarness.git"
  },
  "bugs": {
    "url": "https://github.com/GIStudio/SpatialHarness/issues"
  },
  "author": "GIStudio",
  "license": "MIT",
  "files": [
    "src",
    "demo",
    "docs",
    "scripts",
    "index.html"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp:build": "pnpm --filter @spatial-harness/mcp-server build",
    "mcp:test": "pnpm --filter @spatial-harness/mcp-server test",
    "mcp:smoke": "pnpm --filter @spatial-harness/mcp-server smoke",
    "mcp:typecheck": "pnpm --filter @spatial-harness/mcp-server typecheck"
  },
  "dependencies": {
    "@ngageoint/geopackage": "^4.2.8",
    "@tailwindcss/vite": "^4.1.0",
    "@tmcw/togeojson": "^5.8.0",
    "@turf/area": "^7.2.0",
    "@turf/bbox": "^7.2.0",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/buffer": "^7.2.0",
    "@turf/centroid": "^7.2.0",
    "@turf/difference": "^7.2.0",
    "@turf/dissolve": "^7.2.0",
    "@turf/helpers": "^7.2.0",
    "@turf/intersect": "^7.2.0",
    "@turf/length": "^7.2.0",
    "@turf/union": "^7.2.0",
    "@xmldom/xmldom": "^0.9.11",
    "buffer": "^6.0.3",
    "clsx": "^2.1.1",
    "comlink": "^4.4.2",
    "dexie": "^4.0.11",
    "gdal3.js": "^2.8.1",
    "geotiff": "^2.1.3",
    "lucide-react": "^0.460.0",
    "nanoid": "^5.1.5",
    "ol": "^10.5.0",
    "proj4": "^2.15.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rtree-sql.js": "1.7.0",
    "shpjs": "^4.0.4",
    "tailwindcss": "^4.3.3",
    "upng-js": "^2.1.0",
    "util": "^0.12.5",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.0.0",
    "@types/proj4": "^2.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "~5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}