    "@turf/buffer": "^7.2.0",
    "@turf/centroid": "^7.2.0",
    "@turf/difference": "^7.2.0",
    "@turf/dissolve": "^7.2.0",
    "@turf/helpers": "^7.2.0",
    "@turf/intersect": "^7.2.0",
    "@turf/length": "^7.2.0",
    "@turf/union": "^7.2.0",
    "@xmldom/xmldom": "^0.9.11",
    "buffer": "^6.0.3",
    "clsx": "^2.1.1",
    "comlink": "^4.4.2",
    "dexie": "^4.0.11",
